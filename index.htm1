<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SHIGAU AI STUDIO</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#050817;
 color:white;
 font-family:Arial,sans-serif;
}
header{
 text-align:center;
 padding:25px 12px;
 background:linear-gradient(135deg,#071c45,#080812);
 border-bottom:2px solid #ffc400;
}
.logo{
 width:100px;height:100px;
 border:4px solid gold;
 border-radius:50%;
 display:grid;place-items:center;
 margin:auto;
 font-size:45px;
 font-weight:bold;
 color:#00cfff;
 box-shadow:0 0 25px #008cff;
}
h1{
 color:gold;
 margin-bottom:5px;
 text-shadow:0 0 12px #ff9500;
}
.subtitle{color:#00d9ff}
.container{padding:16px}
input{
 width:100%;
 padding:15px;
 border-radius:12px;
 border:1px solid #00bfff;
 background:#101b35;
 color:white;
 font-size:16px;
}
.banner{
 background:linear-gradient(120deg,#003b85,#63159c);
 padding:25px 15px;
 margin-top:20px;
 border-radius:18px;
 text-align:center;
 border:1px solid #00cfff;
}
.banner h2{color:#ffdf00}
.categories{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
 margin-top:20px;
}
.category{
 background:#111d38;
 border:1px solid #247cff;
 border-radius:15px;
 padding:20px 8px;
 text-align:center;
 cursor:pointer;
}
.category span{
 font-size:35px;
 display:block;
 margin-bottom:10px;
}
.card{
 background:#101b34;
 padding:18px;
 border-radius:15px;
 margin:15px 0;
 border:1px solid #284f99;
}
.card h3{color:#ffdf00}
button{
 background:linear-gradient(90deg,#006bff,#00cfff);
 border:0;
 padding:12px 22px;
 border-radius:25px;
 color:white;
 font-weight:bold;
 cursor:pointer;
}
footer{
 text-align:center;
 padding:25px;
 color:#aabbdd;
}
#splash{
 position:fixed;
 inset:0;
 background:#030716;
 z-index:999;
 display:flex;
 flex-direction:column;
 justify-content:center;
 align-items:center;
 text-align:center;
 padding:20px;
}
#splash h1{font-size:30px}
.spinner{
 width:65px;height:65px;
 border:6px solid #183158;
 border-top:6px solid gold;
 border-radius:50%;
 animation:spin 1s linear infinite;
 margin:30px;
}
@keyframes spin{
 to{transform:rotate(360deg)}
}
.progress{
 width:80%;height:12px;
 background:#15233f;
 border-radius:20px;
 overflow:hidden;
}
.bar{
 height:100%;
 width:0;
 background:linear-gradient(90deg,#00cfff,gold);
 animation:load 3s linear forwards;
}
@keyframes load{
 to{width:100%}
}
</style>
</head>

<body>

<div id="splash">
 <div class="logo">SG</div>
 <h1>SHIGAU AI STUDIO</h1>
 <p>Powered by Shivam Bhai & Gautam Bhai</p>
 <div class="spinner"></div>
 <h3>PROCESSING...</h3>
 <div class="progress"><div class="bar"></div></div>
 <p id="percent">0%</p>
</div>

<header>
 <div class="logo">SG</div>
 <h1>SHIGAU AI STUDIO</h1>
 <div class="subtitle">AI PHOTO & VIDEO PROMPT STUDIO</div>
 <p>👑 Shivam Bhai × Gautam Bhai</p>
 <p>आपकी सोच, हमारा प्रॉम्प्ट!</p>
</header>

<div class="container">

<input id="search" placeholder="🔍 Search AI Prompts..." oninput="showPrompts()">

<div class="banner">
 <h2>🚀 CREATE MORE WITH AI</h2>
 <p>हर फोटो और वीडियो बनेगा शानदार!</p>
 <strong>🔥 FREE AI PROMPTS 🔥</strong>
</div>

<h2>👑 Categories</h2>

<div class="categories">
 <div class="category" onclick="filterType('Photo')">
 <span>📸</span>AI Photo Prompts
 </div>
 <div class="category" onclick="filterType('Video')">
 <span>🎬</span>AI Video Prompts
 </div>
 <div class="category" onclick="filterType('Trending')">
 <span>🔥</span>Trending Prompts
 </div>
 <div class="category" onclick="filterType('Bhojpuri')">
 <span>🎵</span>Bhojpuri Prompts
 </div>
 <div class="category" onclick="filterType('Love')">
 <span>❤️</span>Love & Couple
 </div>
 <div class="category" onclick="filterType('Festival')">
 <span>🙏</span>Festival Prompts
 </div>
 <div class="category" onclick="filterType('Cartoon')">
 <span>😂</span>Cartoon Prompts
 </div>
 <div class="category" onclick="filterType('All')">
 <span>🌟</span>All Prompts
 </div>
</div>

<h2>🔥 Trending AI Prompts</h2>
<div id="prompts"></div>

</div>

<footer>
 👑 SHIGAU AI STUDIO<br><br>
 Created by Shivam Bhai & Gautam Bhai<br>
 © 2026 All Rights Reserved
</footer>

<script>
const data=[
{
 title:"Cinematic AI Photo",
 type:"Photo",
 prompt:"Create an ultra-realistic cinematic portrait with natural lighting, professional camera quality, detailed background and sharp focus. Preserve the reference person's facial identity."
},
{
 title:"AI Cinematic Video",
 type:"Video",
 prompt:"Create a 10-second vertical 9:16 cinematic video with realistic movement, smooth camera motion, dramatic lighting and professional quality."
},
{
 title:"Viral Trending Photo",
 type:"Trending",
 prompt:"Create a stunning viral-style portrait with cinematic colors, realistic skin texture, stylish background and high-quality photography."
},
{
 title:"Bhojpuri Shayari Video",
 type:"Bhojpuri",
 prompt:"Create a cinematic Bhojpuri shayari video with a village background, expressive character, natural dialogue delivery and smooth camera movement. No background song."
},
{
 title:"Couple Photo",
 type:"Love",
 prompt:"Create a beautiful cinematic couple portrait under cherry blossom trees, natural expressions, soft lighting and realistic photography."
},
{
 title:"Festival Photo",
 type:"Festival",
 prompt:"Create a beautiful Indian festival scene with traditional decorations, flowers, lights and cinematic photography."
},
{
 title:"3D Cartoon Video",
 type:"Cartoon",
 prompt:"Create a colorful 3D animated short video with expressive cartoon characters, smooth animation, vibrant scenery and cinematic camera movement."
}
];

let selected="All";

function filterType(type){
 selected=type;
 showPrompts();
 document.getElementById("prompts").scrollIntoView({
 behavior:"smooth"
 });
}

function showPrompts(){
 const q=document.getElementById("search").value.toLowerCase();
 const box=document.getElementById("prompts");
 box.innerHTML="";

 data.filter(p=>
 (selected==="All"||p.type===selected)&&
 (p.title.toLowerCase().includes(q)||
 p.prompt.toLowerCase().includes(q))
 ).forEach(p=>{
 const card=document.createElement("div");
 card.className="card";

 const title=document.createElement("h3");
 title.textContent=p.title;

 const desc=document.createElement("p");
 desc.textContent=p.prompt;

 const btn=document.createElement("button");
 btn.textContent="📋 Copy Prompt";
 btn.onclick=()=>copyPrompt(p.prompt,btn);

 card.append(title,desc,btn);
 box.appendChild(card);
 });

 if(!box.children.length){
 box.textContent="कोई प्रॉम्प्ट नहीं मिला।";
 }
}

async function copyPrompt(text,btn){
 try{
 await navigator.clipboard.writeText(text);
 btn.textContent="✅ Copied!";
 setTimeout(()=>btn.textContent="📋 Copy Prompt",2000);
 }catch(e){
 alert("कॉपी नहीं हुआ। कृपया प्रॉम्प्ट चुनकर कॉपी करें।");
 }
}

let n=0;
const timer=setInterval(()=>{
 n=Math.min(n+5,100);
 document.getElementById("percent").textContent=n+"%";
 if(n===100)clearInterval(timer);
},150);

setTimeout(()=>{
 document.getElementById("splash").style.display="none";
},3200);

showPrompts();
</script>

</body>
  </html>
